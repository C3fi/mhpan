// ============================================================================
// INPUT
// ============================================================================

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle,compose:ralt" 
        }
        numlock
    }

    touchpad { 
        tap
        natural-scroll
        drag true
    }

    mouse {
        // off                       // Uncomment to disable mouse
        // natural-scroll            // Uncomment to enable natural scrolling
        accel-speed 0.2
        accel-profile "flat"
        // scroll-method "no-scroll" // Uncomment to disable scrolling
    }

    trackpoint { // Disabled (ThinkPad trackpoint)
        off
    }

    // Focus follows mouse; windows must be at least 50% visible to receive focus
    focus-follows-mouse max-scroll-amount="50%"
}

// ============================================================================
// OUTPUTS
// ============================================================================

output "eDP-1" {
    mode "1920x1080@60.020"
    scale 1
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080@75.003"
    scale 1
    position x=0 y=0
}

// ============================================================================
// LAYOUT
// ============================================================================

layout {
    gaps 16
    center-focused-column "never"

    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#124329"     
        inactive-color "#5f5e4e"   
    }

    border { 
        off                         // Disable additional border (focus-ring is used)
    }

    shadow {
        softness 35
        spread 6
        offset x=0 y=6
        color "#22221bCC"          
    }
    struts {
        // left 64                  // Uncomment to reserve space on each side
        // right 64
        // top 64
        // bottom 64
    }
}

// ============================================================================
// WORKSPACES
// ============================================================================

workspace "1" {
    open-on-output "LVDS-1"
}

workspace "2" {
    open-on-output "LVDS-1"
}

workspace "3" {
    open-on-output "LVDS-1"
}

workspace "4" {
    open-on-output "LVDS-1"
}

workspace "5" {
    open-on-output "LVDS-1"
}

workspace "6" {
    open-on-output "LVDS-1"
}


include "startsup.kdl"

// ============================================================================
// GLOBAL SETTINGS
// ============================================================================

// Skip the hotkey overlay popup on startup
hotkey-overlay {
    skip-at-startup
}

// Ask clients not to draw their own window decorations
prefer-no-csd

// Screenshot save path with date formatting
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Animation speed multiplier (1 = normal)
animations {
    slowdown 1
}

include "window-rule.kdl"

include "hotkeys.kdl"